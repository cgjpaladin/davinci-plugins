# AI去字幕 环境变量配置
# 复制此文件为 .env 并填入真实密钥
# 位置：与 config.py 同目录（SMB 部署路径）

# ── 鬼手剪辑 GhostCut（当前主力）──
GHOSTCUT_APP_KEY=
GHOSTCUT_APP_SECRET=

# ── 无痕AI V2.1 ──
WUHENAI_V2_API_KEY=

# ── 阿里云 OSS（无痕AI V2 文件存储用）──
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=wuhenai-clipflow
OSS_REGION=cn-hangzhou

# ── 火山引擎 VOD ──
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=

# ── 腾讯云 MPS ──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# ── 阿里云 IMS ──
ALIYUN_ACCESS_KEY=
ALIYUN_SECRET_KEY=

# ── 处理设置 ──
# WATERMARK_MODE=pro_box        # basic | pro_box
# WATERMARK_COLOR=Orange
# WATERMARK_DEBUG=1             # 调试模式
# WATERMARK_FORCE=1             # 跳过缓存
# WATERMARK_CONCURRENT=5
# WATERMARK_PROJECT=/Volumes/MYJC/01_短剧项目/项目名
